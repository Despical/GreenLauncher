{
  "name": "green-launcher",
  "version": "0.17.2",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "description": "A custom Minecraft Java Edition launcher",
  "main": "./out/main/index.js",
  "author": "Despical",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "dist:portable": "pnpm run build && node scripts/build_portable.mjs",
    "dist:win": "pnpm dist:portable",
    "dist:setup": "pnpm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@xhayper/discord-rpc": "1.5.1",
    "@xmcl/core": "^2.16.2",
    "@xmcl/installer": "^6.3.4",
    "@xmcl/user": "^4.4.2",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "prismarine-nbt": "2.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "skinview3d": "3.4.2",
    "yauzl": "2.10.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "pnpm": {
    "overrides": {
      "@xmcl/unzip": "2.1.2"
    },
    "patchedDependencies": {
      "@xmcl/installer@6.3.4": "patches/@xmcl__installer@6.3.4.patch"
    }
  },
  "build": {
    "appId": "com.greenlauncher.desktop",
    "productName": "GreenLauncher",
    "executableName": "GreenLauncher",
    "publish": { "provider": "github", "owner": "Despical", "repo": "GreenLauncher" },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@xmcl/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/tray-icon.ico",
        "to": "tray-icon.ico"
      },
      {
        "from": "build/portable-splash.png",
        "to": "portable-splash.png"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "GreenLauncher.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GreenLauncher-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Green Launcher"
    }
  }
}
